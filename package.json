{
  "name": "loyalty-card-for-apple-wallet",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "description": "Digital stamp card for a coffee shop, delivered through Apple Wallet",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "build:web": "node scripts/build-web.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "certs:test": "tsx scripts/make-test-certs.ts",
    "barista:add": "tsx --env-file-if-exists=.env scripts/add-barista.ts",
    "predev": "npm run build:web",
    "prestart": "npm run build:web"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "fastify": "^5.12.7",
    "libphonenumber-js": "^1.13.15",
    "passkit-generator": "^3.7.0",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/node-forge": "^1.3.14",
    "@types/pg": "^8.23.1",
    "@zxing/browser": "^0.2.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "fflate": "^0.8.3",
    "node-forge": "^1.4.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@embedded-postgres/windows-x64@18.4.0-beta.17": true
  }
}
