# Copy to .env and fill in. Never commit .env.

# PostgreSQL connection, e.g. postgres://user:password@localhost:5432/loyalty
DATABASE_URL=

# The HTTPS address phones use to reach this service (written into every pass),
# e.g. https://xxxx.trycloudflare.com during development
PUBLIC_BASE_URL=

# Port the service listens on
PORT=3000

# From the Apple Developer portal
PASS_TYPE_ID=pass.com.example.loyalty
APPLE_TEAM_ID=

# Pass Type ID certificate and key (PEM), and the Apple WWDR intermediate certificate (PEM)
PASS_CERT_PATH=./certs/pass.pem
PASS_KEY_PATH=./certs/pass.key
PASS_KEY_PASSPHRASE=
WWDR_CERT_PATH=./certs/wwdr.pem

# Shown on the card
SHOP_NAME=Coffee Shop

# Apple push host. Leave as is; tests point this at a local fake.
APNS_HOST=https://api.push.apple.com

# Long random secrets (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
PIN_PEPPER=
SESSION_SECRET=

# The Admin account, created on first start if none exists
ADMIN_USERNAME=owner
ADMIN_PASSWORD=

# Egypt: numbers typed without a country code are read as Egyptian (+20)
DEFAULT_PHONE_REGION=EG
